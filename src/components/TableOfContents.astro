---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
}

const problems = Astro.props.headings.filter((heading) => heading.depth === 2);
---

{problems.length > 0 && (
	<nav class="toc" aria-label="文章目录">
		<p>题目目录</p>
		<ol>
			{problems.map((problem) => <li><a href={`#${problem.slug}`}>{problem.text}</a></li>)}
		</ol>
	</nav>
)}

<style>
	.toc {
		margin: 0;
		padding: 0 0 0 1rem;
		border-left: 3px solid var(--accent);
	}
	.toc p { margin: 0 0 0.5rem; font-weight: 700; }
	.toc ol { margin: 0; padding-left: 1.25rem; }
	.toc li { margin: 0.2rem 0; }
	.toc a { color: inherit; text-decoration: none; }
	.toc a:hover { color: var(--accent); }
</style>
