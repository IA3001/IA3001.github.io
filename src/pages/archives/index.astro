---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('posts', ({ data }) => data.published)).sort((a, b) => {
	const aUpdated = a.data.updated?.getTime() ?? a.data.date?.getTime() ?? 0;
	const bUpdated = b.data.updated?.getTime() ?? b.data.date?.getTime() ?? 0;
	return bUpdated - aUpdated || (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0) || a.id.localeCompare(b.id);
});
const dated = new Map<string, typeof posts>();
const undated: typeof posts = [];
for (const post of posts) {
	if (!post.data.date) { undated.push(post); continue; }
	const year = String(post.data.date.getFullYear());
	if (!dated.has(year)) dated.set(year, []);
	dated.get(year)!.push(post);
}
const years = [...dated.entries()].sort(([a], [b]) => b.localeCompare(a));
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={`归档 | ${SITE_TITLE}`} description="按年份浏览博客文章" /></head>
	<body>
		<Header />
		<main>
			<h1>文章归档</h1>
			{years.map(([year, entries]) => (
				<section><h2>{year}</h2><ul>{entries.map((post) => (
					<li><time datetime={post.data.date!.toISOString()}>{post.data.date!.toISOString().slice(0, 10)}</time> <a href={`/posts/${post.id}/`}>{post.data.title}</a></li>
				))}</ul></section>
			))}
			{undated.length > 0 && <section><h2>未标注日期</h2><ul>{undated.map((post) => (
				<li><a href={`/posts/${post.id}/`}>{post.data.title}</a></li>
			))}</ul></section>}
			{posts.length === 0 && <p>还没有已发布的文章。</p>}
		</main>
		<Footer />
	</body>
</html>
