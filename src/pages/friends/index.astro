---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { friends } from '../../data/friends';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={`友链 | ${SITE_TITLE}`} description="常用算法竞赛与在线评测网站" /></head>
	<body>
		<Header />
		<main>
			<h1>友链</h1>
			<ul class="friends">
				{friends.map((friend) => (
					<li><a href={friend.url} target="_blank" rel="noopener noreferrer">
						<img src={friend.logo} alt="" loading="lazy" />
						<span><strong>{friend.name}</strong><small>{friend.description}</small></span>
					</a></li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.friends { padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
	.friends li a { display: flex; align-items: center; gap: 1rem; height: 100%; padding: 1rem; border: 1px solid rgb(var(--gray-light)); border-radius: 0.5rem; color: inherit; text-decoration: none; }
	.friends img { width: 40px; height: 40px; object-fit: contain; }
	.friends span { display: grid; }
	.friends small { color: rgb(var(--gray)); }
</style>
