---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('posts', ({ data }) => data.published);
	const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
	return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = await getCollection('posts', (post) => post.data.published && post.data.tags.includes(tag));
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={`#${tag} | ${SITE_TITLE}`} description={`浏览标签 ${tag} 下的文章`} /></head>
	<body>
		<Header />
		<main>
			<h1>标签：{tag}</h1>
			<ul>{posts.map((post) => <li><a href={`/posts/${post.id}/`}>{post.data.title}</a></li>)}</ul>
		</main>
		<Footer />
	</body>
</html>
